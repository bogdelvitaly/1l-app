generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon) — no field below uses a native enum type, just plain
// strings validated in code (see src/lib/types.ts), so the switch from the
// original SQLite dev setup needed no other schema changes.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  expenses     Expense[]
  incomes      Income[]
  certificates Certificate[]
  changeLogs   ChangeLog[]
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  category    String // NALOG | SEBESTOIMOST | ZARPLATA | RAZVITIE | MASTERSKAYA | OTPRAVKA
  amount      Float
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model Income {
  id            String   @id @default(cuid())
  date          DateTime
  // No longer required — Товар is required instead now, saleDetails is a
  // free-text supplement.
  saleDetails   String?
  amount        Float
  shipping      Float    @default(0)
  delivery      Float    @default(0)
  paymentMethod String // NAL | BEZNAL
  // Not submitted from the form anymore — derived server-side from the selected
  // Product when one is chosen, left untouched otherwise, so it's nullable now.
  productType   String? // V_K | V_V | V_RGB | VV_RGB | M_30 | M_50 | M_70
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Added alongside saleDetails, not replacing it — old rows keep saleDetails
  // as their only detail; new rows can additionally pick a catalog Product
  // and note the buyer/city as their own fields.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  buyer     String?
  city      String?
  source    String? // SITE | INSTAGRAM | ADS | WORD_OF_MOUTH | STORE | OTHER

  // Налогом облагаются не все доходы (напр. предоплата, компенсация) — этот флаг
  // исключает запись из выручки, по которой считается фактический налог за месяц.
  // Существующие записи получают true при миграции, чтобы прошлые отчёты не изменились.
  taxable Boolean @default(true)

  // Set only when this income was created from a Заказы card dropped onto Done —
  // lets /orders reconcile Done membership (in Trello or in-app) back to this row:
  // moved out of Done → row deleted, see reconcileDoneOrders in src/lib/orderSync.ts.
  trelloCardId String? @unique

  @@index([date])
  @@index([productType])
}

model Certificate {
  id          String   @id @default(cuid())
  sequenceNo  Int      @unique
  number      String   @unique // "{sequenceNo}-{ddMMyyyy}"
  amount      Float
  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Себестоимость по типу товара = сумма price всех CostComponent этого типа (считается на лету).
// Типы товара — управляемый пользователем список (можно добавлять/удалять), а не жёсткий enum,
// поэтому Income.productType хранит просто code как строку без FK (чтобы удаление типа
// не ломало исторические продажи).
model ProductType {
  id         String          @id @default(cuid())
  code       String          @unique
  label      String
  createdAt  DateTime        @default(now())
  components CostComponent[]
  products   Product[]
}

// A concrete, sellable item (distinct from ProductType, which is just the
// broad category like В-К/М-30 used for cost-basis grouping in reports).
// Каждый Товар принадлежит ровно одному Типу товара.
model Product {
  id            String      @id @default(cuid())
  name          String
  price         Float // sale price — prefills Income.amount when sold from a Store
  color         String // hex, e.g. "#519ef5" — badge color in the Доходы table
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  createdAt     DateTime    @default(now())

  incomes Income[]
  stores  StoreProduct[]
}

model CostComponent {
  id            String      @id @default(cuid())
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  createdAt     DateTime    @default(now())
}

model Store {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())

  products StoreProduct[]
}

// Join table — a Product can sit on the shelf of several Stores at once.
model StoreProduct {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

// Per-month running counter behind the order number Trello cards get on create
// (see createOrderAction) — formatted "MMYY/N" (unpadded, 1-999), counter resets at the start of
// each month since monthKey itself changes. Never shown in the "Добавить заказ"
// form; only appears in the resulting card's title.
model OrderSequence {
  monthKey String @id // "MMYY", e.g. "0926" for September 2026
  counter  Int    @default(0)
}

model ChangeLog {
  id         String   @id @default(cuid())
  entityType String // Expense | Income | Certificate
  entityId   String
  action     String // create | update | delete
  diff       String // JSON string
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
