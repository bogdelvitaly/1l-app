# Local dev: SQLite, zero setup.
# Production (Vercel + Neon): postgresql://... connection string, and set
# provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Заказы (/orders) — mirrors a Trello board's Kanban. Get a Key + read/write
# Token at https://trello.com/power-ups/admin (create any Power-Up, then its
# "API Key" tab has both). Board ID is the segment after /b/ in the board URL.
TRELLO_KEY=""
TRELLO_TOKEN=""
TRELLO_BOARD_ID=""
